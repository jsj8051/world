[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/Scene/Navigation/AppRoot.cs" id="1_app"]
[ext_resource type="PackedScene" path="res://scenes/app/AppStatusBar.tscn" id="2_status"]
[ext_resource type="PackedScene" path="res://scenes/app/LoadingOverlay.tscn" id="3_load"]

[node name="AppRoot" type="Node"]
script = ExtResource("1_app")
ScreenHostPath = NodePath("ScreenHost")
StatusBarPath = NodePath("AppStatusBar")
LoadingOverlayPath = NodePath("LoadingOverlay")

[node name="ScreenHost" type="Node" parent="."]

[node name="AppStatusBar" parent="." instance=ExtResource("2_status")]

[node name="LoadingOverlay" parent="." instance=ExtResource("3_load")]
