[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/UI/Components/LoadProgressBar.cs" id="1_bar"]

[node name="LoadProgressBar" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_bar")
TitlePath = NodePath("Title")
BarPath = NodePath("Bar")
StagePath = NodePath("Meta/Stage")
PercentPath = NodePath("Meta/Percent")

[node name="Title" type="Label" parent="."]
theme_override_font_sizes/font_size = 22
text = "加载中"

[node name="Bar" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(0, 24)
size_flags_horizontal = 3
max_value = 100.0
show_percentage = false

[node name="Meta" type="HBoxContainer" parent="."]

[node name="Stage" type="Label" parent="Meta"]
layout_mode = 2
size_flags_horizontal = 3
text = ""

[node name="Percent" type="Label" parent="Meta"]
layout_mode = 2
text = "0/0"
