[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Scene/WorldRoot.cs" id="1_root"]
[ext_resource type="Script" path="res://scripts/Scene/WorldManager.cs" id="2_world"]
[ext_resource type="PackedScene" path="res://scenes/render/WorldPresentation.tscn" id="3_presentation"]
[ext_resource type="PackedScene" path="res://scenes/app/AppMenu.tscn" id="4_menu"]

[node name="WorldRoot" type="Node3D"]
script = ExtResource("1_root")
WorldManagerPath = NodePath("WorldManager")
RenderManagerPath = NodePath("Presentation/RenderManager")
UIManagerPath = NodePath("Presentation/UIManager")
CameraPath = NodePath("Presentation/OrbitalCamera")
DockPath = NodePath("Presentation/UIManager/PanelLayer/MapDock")
AppMenuPath = NodePath("AppMenu")

[node name="WorldManager" type="Node3D" parent="."]
script = ExtResource("2_world")
EnableEvolution = true

[node name="Presentation" parent="." instance=ExtResource("3_presentation")]

[node name="AppMenu" parent="." instance=ExtResource("4_menu")]
