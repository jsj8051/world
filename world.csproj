<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>world</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试 / 诊断工程放 tests/，整体排除出游戏程序集（见 tests/README.md）。 -->
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
    <!-- CivSim 整棵闭包移入 scripts/_removed/ 并排除编译（移出而非删除，回归时移回并删掉这两行）。 -->
    <Compile Remove="scripts/_removed/**/*.cs" />
    <None Remove="scripts/_removed/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 单测直测 internal 纯函数与测试钩子（如 TechTable.LoadForTest）。 -->
    <InternalsVisibleTo Include="World.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- H3 原生库（native/h3/h3.dll，Uber h3 v4.5.0 MinGW 编译）：经 Link 扁平拷到输出根目录，
         H3Native 按 AppContext.BaseDirectory 查找（Godot 宿主为 .godot/mono/temp/bin/Debug）。 -->
    <None Include="native/h3/h3.dll" Link="h3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>