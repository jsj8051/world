# Godot 4+ specific ignores
.godot/
/android/

# 用户数据（2026-08-25 地图≠存档分层：游戏目录旁 userdata/——maps 素材池 + saves 存档，绝不入库）
userdata/

# 世界参数·用户档（2026-10-11 参数迁入 res/params/：默认档 world_params.json 是正库、**入库**；
# 用户档由 UI / 参数管理器随时改写 ⇒ 属运行产物，不入库。删掉它 = 恢复出厂）
res/params/world_params.user.json

# 数据编辑器自动备份（data/techs.csv.bak 等——每次保存前的快照，不入库）
*.bak

# C# build artifacts
*.lscache
*.old
bin/
obj/

# Godot 导入元数据（.import 入库：官方 VCS 指南要求提交，保证 uid 稳定；
# 已入库 icon.svg.import 与 addons/**/*.import。docs/ 有 .gdignore 不参与导入）
# Godot 4.4+ 资源/脚本 uid 文件（.uid）一律入库，与场景 ext_resource 的 uid= 引用配套

# 本地启动脚本（不入库）
/启动deepseek-harness.bat

# 运行日志（按分类落 logs/ 各子目录；不入库）
/logs/

# Godot 运行期 user:// 重定向目录（APPDATA→runs/appdata；运行产物不入库）
# 测试用 v5 存档也属运行资源，不入库
/runs/

# 工具本地缓存（空 tmp；不入库）
/.hermes/

# 诊断截图输出（NoiseShotDiag 等默认落 maps/xxx.png，与 logs/runs 同为运行产物，不入库）
/maps/

# 本地排查草稿（日志、截图等临时产物）
/scratch/

# Workbuddy 工具本地数据
/.workbuddy/

# DSH 沙箱 ACL 取证备份（工具本地产物：权限快照与回滚脚本，不入库）
/.acl-recovery/
