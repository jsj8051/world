# Godot 4+ specific ignores
.godot/
/android/

# C# build artifacts
*.lscache
*.old
bin/
obj/

# Godot 导入元数据（.import 入库：官方 VCS 指南要求提交，保证 uid 稳定；
# 已入库 icon.svg.import 与 addons/**/*.import。docs/ 有 .gdignore 不参与导入）
# Godot 4.4+ 资源/脚本 uid 文件（.uid）一律入库，与场景 ext_resource 的 uid= 引用配套

# 本地启动脚本（不入库）
/启动deepseek-harness.bat

# 运行日志（按分类落 logs/ 各子目录；不入库）
/logs/

# Godot 运行期 user:// 重定向目录（APPDATA→runs/appdata；运行产物不入库）
# 测试用 v5 存档也属运行资源，不入库
/runs/
