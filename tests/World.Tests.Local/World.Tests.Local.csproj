<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>World.Tests.Local</RootNamespace>
    <AssemblyName>World.Tests.Local</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用同一套 NUnit 测试源码：CI/本机用 `dotnet test`，受限环境用本执行器 -->
    <ProjectReference Include="..\World.Tests\World.Tests.csproj" />
  </ItemGroup>

</Project>
